; Ejemplo de configuración local de EOSG.
; Copiar a la carpeta de datos de usuario como `eosg.cfg` y completar.
; En Linux suele ser:
;   ~/.local/share/godot/app_userdata/Darker Than Darkness/eosg.cfg
;
; NUNCA versionar el eosg.cfg real: contiene el client secret.
; Para builds por defecto se puede copiar este archivo como res://eosg.cfg;
; EOSGProvider usa user://eosg.cfg si está completo y, si no, res://eosg.cfg.
; Alternativa: definir EOS_PRODUCT_ID, EOS_SANDBOX_ID, EOS_DEPLOYMENT_ID,
; EOS_CLIENT_ID y EOS_CLIENT_SECRET como variables de entorno.

[eos]
product_name="Darker Than Darkness"
product_version="1.0.0"
product_id=""
sandbox_id=""
deployment_id=""
client_id=""
client_secret=""
; Opcional. Si falta, EOSG usa cifrado interno.
encryption_key=""

; anonymous | devtool | account_portal | launcher
login_mode="anonymous"
devtool_host="localhost:4545"
devtool_credential="DarkerPlayer"
