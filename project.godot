window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"
window/max_fps=0
window/windows_native_icon=""
window/macos_native_icon=""
window/screen_space_roughness_limiter/enabled=true

[dotnet]

project/assembly_name="Perosnajes"

[editor]

