[netfox]

time/tickrate=30
time/sync_to_physics=true
time/suppress_offline_peer_warning=true
rollback/enabled=true
rollback/history_limit=64
rollback/input_redundancy=3
rollback/input_delay=0
rollback/display_offset=0
rollback/enable_diff_states=true
events/enabled=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[plugins]

claude_api/api_key=""

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/screen_space_roughness_limiter/enabled=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[steam]

initialization/app_data/app_type=2
initialization/app_data/app_id=0
initialization/app_data/demo_id=0
initialization/app_data/playtest_id=0
initialization/app_data/tool_id=0
initialization/processes/initialize_on_startup=false
initialization/processes/embed_callbacks=false
multiplayer_peer/max_channels=4
